# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret for signing authentication cookies/tokens.
SESSION_SECRET="change_this_to_a_strong_random_secret"

# Uzbekistan SMS Gateway API (e.g. Eskiz.uz / PlayMobile compatible endpoint)
# Leave empty to run SMS notifications and OTP verification in explicit DEMO mode.
SMS_GATEWAY_URL=""
SMS_GATEWAY_TOKEN=""
SMS_GATEWAY_SENDER="348-MAKTAB"

# Click.uz Official Merchant API Credentials (server-side only, never exposed to frontend)
# Leave empty to run Click subscription payments in explicit DEMO mode.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_SECRET_KEY=""
